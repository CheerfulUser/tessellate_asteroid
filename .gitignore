# Bulk data products -- regenerated by the pipeline, far too large to track.
# lcdb_lcs/ alone is 6.7 GB of per-object lightcurves.
lcdb_lcs/
label_lcs*/
clean_lightcurves/
*_figs/
quality_bins/
regime_examples/
folded_products/

# The full catalogue (48 MB) is a build artefact of the ozstar run, not source.
all_sector_report*.csv
all_sector_asteroid_report*.csv

# Trained models are version-specific: a laptop-trained pickle will NOT load on ozstar
# (numpy 2.5 vs 1.26). Track the training TABLE instead and retrain on the target machine.
*.joblib

# convexinv build products
shape/DAMIT-convex/
*.o
*.so

__pycache__/
*.pyc
.DS_Store
